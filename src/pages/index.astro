---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import importShot from '../assets/screenshots/import.png';
import manualAddShot from '../assets/screenshots/manual-add.png';
import rulesShot from '../assets/screenshots/rules.png';
import dashboardShot from '../assets/screenshots/dashboard.png';

const journey = [
	{
		number: '01',
		title: 'Import your bank statements',
		text: 'Upload an Excel, CSV, or PDF file. Every row goes through a preview where you can review, edit, or exclude it before anything is added to your account — column mapping is remembered per bank, and duplicates are caught automatically.',
		formats: ['.xlsx', '.xls', '.csv', '.pdf'],
		image: importShot,
		alt: 'Vezne import screen with a file upload field and saved column mapping selector',
		layout: 'side',
	},
	{
		text: "Prefer not to upload a file? Add transactions one at a time instead — handy for cash purchases a statement won't show.",
		image: manualAddShot,
		alt: 'Vezne "New transaction" dialog filled in for a cash taxi expense, with amount, category, and tags',
		layout: 'side',
		reverse: true,
	},
	{
		number: '02',
		title: 'Categorize it automatically',
		text: 'Rules match transaction text — contains, equals, starts with, or ends with — and run in priority order during import, assigning a specific category and tags automatically. Set them up once and every future statement sorts itself.',
		image: rulesShot,
		alt: 'Vezne rules table listing three automation rules with their match text and assigned category',
		layout: 'side',
	},
	{
		number: '03',
		title: 'See where your money goes',
		text: "Down to the sub-category, not just the category. Most banking apps show ‘Transportation’ as one lump sum — Vezne splits it into flights, taxis, and whatever else you set up, alongside income, net savings, and trends over time.",
		image: dashboardShot,
		alt: 'Vezne dashboard with income, expense, and net savings charts and a category breakdown',
		layout: 'full',
	},
];
---

<SiteLayout
	title="Personal finance tracker"
	description="Vezne is a personal finance tracker — import bank statements or add transactions yourself, auto-categorize what you import with rules, and see where your money goes."
	wide
>
	<section class="hero">
		<h1>Track your money without connecting your bank.</h1>
		<p class="lede">
			Import bank statements or add transactions yourself, let rules
			auto-categorize what you import, and see exactly where your money goes.
		</p>
		<div class="hero-actions">
			<a class="cta-primary" href="https://app.vezne.app/register">Go to app →</a>
			<a class="cta-secondary" href="#how-it-works">See how it works</a>
		</div>
		<p class="trust">
			No bank connection, ever — Vezne only sees the statement files you
			choose to upload.
		</p>
	</section>

	<section class="journey" id="how-it-works">
		<p class="section-label">How it works</p>
		{
			journey.map((step) => (
				<div
					class:list={[
						'journey-row',
						step.layout === 'full' && 'journey-row--full',
						step.reverse && 'journey-row--reverse',
					]}
				>
					<div class="journey-text">
						{step.number && <span class="journey-number">{step.number}</span>}
						{step.title && <h3>{step.title}</h3>}
						<p>{step.text}</p>
						{step.formats && (
							<ul class="formats">
								{step.formats.map((format) => (
									<li>{format}</li>
								))}
							</ul>
						)}
					</div>
					<div class="journey-frame">
						<Image src={step.image} alt={step.alt} />
					</div>
				</div>
			))
		}
	</section>
</SiteLayout>

<style>
	:global(html) {
		scroll-behavior: smooth;
	}

	.hero {
		max-width: 640px;
		margin: 2rem 0 4rem;
	}

	.hero h1 {
		margin: 0 0 1rem;
		font-size: 2.75rem;
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: -0.02em;
	}

	.lede {
		margin: 0 0 1.75rem;
		font-size: 1.1rem;
		line-height: 1.6;
		color: #a39e95;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		margin-bottom: 1.25rem;
	}

	.cta-primary {
		color: #1a0d04;
		background: #c17b45;
		text-decoration: none;
		font-size: 0.95rem;
		font-weight: 600;
		padding: 0.7rem 1.25rem;
		border-radius: 8px;
	}

	.cta-primary:hover {
		background: #d99a6c;
	}

	.cta-secondary {
		color: #ece7df;
		text-decoration: none;
		font-size: 0.9rem;
		border-bottom: 1px solid rgba(236, 231, 223, 0.3);
		padding-bottom: 2px;
	}

	.cta-secondary:hover {
		border-bottom-color: #ece7df;
	}

	.trust {
		margin: 0;
		font-size: 0.85rem;
		color: #a39e95;
	}

	.journey {
		padding-top: 3rem;
		margin-bottom: 4rem;
		border-top: 1px solid rgba(236, 231, 223, 0.08);
	}

	.section-label {
		margin: 0 0 3rem;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #a39e95;
	}

	.journey-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: center;
	}

	.journey-row + .journey-row {
		margin-top: 5rem;
	}

	.journey-row--reverse .journey-frame {
		order: -1;
	}

	.journey-row--full {
		grid-template-columns: 1fr;
	}

	.journey-row--full .journey-text {
		max-width: 640px;
	}

	.journey-number {
		display: block;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		color: #c17b45;
		margin-bottom: 0.75rem;
	}

	.journey-text h3 {
		margin: 0 0 0.75rem;
		font-size: 1.4rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.journey-text p {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.65;
		color: #a39e95;
	}

	.formats {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1rem 0 0;
		padding: 0;
	}

	.formats li {
		font-size: 0.75rem;
		color: #a39e95;
		border: 1px solid rgba(236, 231, 223, 0.12);
		border-radius: 6px;
		padding: 0.15rem 0.5rem;
	}

	.journey-frame {
		background: #100e0b;
		border: 1px solid rgba(236, 231, 223, 0.08);
		border-radius: 12px;
		overflow: hidden;
		line-height: 0;
	}

	.journey-row--full .journey-frame {
		margin-top: 2.5rem;
	}

	.journey-frame :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}

	@media (max-width: 860px) {
		.hero h1 {
			font-size: 2rem;
		}

		.journey-row,
		.journey-row--full {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.journey-row + .journey-row {
			margin-top: 3rem;
		}

		.journey-row--reverse .journey-frame {
			order: 0;
		}

		.journey-row--full .journey-frame {
			margin-top: 0;
		}
	}
</style>
