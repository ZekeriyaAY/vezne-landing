---
import SiteLayout from '../layouts/SiteLayout.astro';

const steps = [
	{
		title: 'Import',
		text: 'Upload an Excel, CSV, or PDF bank statement. Every row goes through a preview where you can review, edit, or exclude it before anything is added to your account.',
	},
	{
		title: 'Automate',
		text: 'Set a rule once and it runs on every future import — match transaction text and assign a category, type, or tags automatically.',
	},
	{
		title: 'Understand',
		text: 'A dashboard shows income, expenses, and net savings, with category breakdowns and month-over-month trends.',
	},
];

const features = [
	{
		title: 'Bank statement import',
		text: 'Column mapping is remembered per bank, duplicate transactions are caught automatically, and nothing is added to your account without a review step first.',
		formats: ['.xlsx', '.xls', '.csv', '.pdf'],
	},
	{
		title: 'Automation rules',
		text: 'Rules match transaction text — contains, equals, starts with, or ends with — and run in priority order, assigning a category and optionally a type or tags. Recurring transactions sort themselves.',
	},
	{
		title: 'Dashboard & insights',
		text: 'Income, expenses, net savings, and transaction count at a glance, plus category breakdowns, daily trends, and monthly comparisons.',
	},
];
---

<SiteLayout
	title="Personal finance tracker"
	description="Vezne is a personal finance tracker — import bank statements, automate categorization with rules, and see where your money goes."
	wide
>
	<section class="hero">
		<h1>Track your money without connecting your bank.</h1>
		<p class="lede">
			Import your bank statement files, set rules that categorize new
			transactions automatically, and see exactly where your money goes.
		</p>
		<div class="hero-actions">
			<a class="cta-primary" href="https://app.vezne.app/register">Go to app →</a>
			<a class="cta-secondary" href="/faq">See how it works</a>
		</div>
		<p class="trust">
			No bank connection, ever — Vezne only sees the statement files you
			choose to upload.
		</p>
	</section>

	<section class="steps">
		{
			steps.map((step, i) => (
				<div class="step">
					<span class="step-index">{String(i + 1).padStart(2, '0')}</span>
					<h3>{step.title}</h3>
					<p>{step.text}</p>
				</div>
			))
		}
	</section>

	<section class="features">
		{
			features.map((feature) => (
				<div class="feature">
					<h3>{feature.title}</h3>
					<p>{feature.text}</p>
					{feature.formats && (
						<ul class="formats">
							{feature.formats.map((format) => (
								<li>{format}</li>
							))}
						</ul>
					)}
				</div>
			))
		}
	</section>
</SiteLayout>

<style>
	.hero {
		max-width: 640px;
		margin: 2rem 0 4rem;
	}

	.hero h1 {
		margin: 0 0 1rem;
		font-size: 2.75rem;
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: -0.02em;
	}

	.lede {
		margin: 0 0 1.75rem;
		font-size: 1.1rem;
		line-height: 1.6;
		color: #a39e95;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		margin-bottom: 1.25rem;
	}

	.cta-primary {
		color: #1a0d04;
		background: #c17b45;
		text-decoration: none;
		font-size: 0.95rem;
		font-weight: 600;
		padding: 0.7rem 1.25rem;
		border-radius: 8px;
	}

	.cta-primary:hover {
		background: #d99a6c;
	}

	.cta-secondary {
		color: #ece7df;
		text-decoration: none;
		font-size: 0.9rem;
		border-bottom: 1px solid rgba(236, 231, 223, 0.3);
		padding-bottom: 2px;
	}

	.cta-secondary:hover {
		border-bottom-color: #ece7df;
	}

	.trust {
		margin: 0;
		font-size: 0.85rem;
		color: #a39e95;
	}

	.steps {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
		padding: 2.5rem 0;
		border-top: 1px solid rgba(236, 231, 223, 0.08);
		border-bottom: 1px solid rgba(236, 231, 223, 0.08);
		margin-bottom: 4rem;
	}

	.step-index {
		display: block;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		color: #c17b45;
		margin-bottom: 0.75rem;
	}

	.step h3 {
		margin: 0 0 0.5rem;
		font-size: 1.05rem;
		font-weight: 600;
	}

	.step p {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.6;
		color: #a39e95;
	}

	.features {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
		margin-bottom: 3rem;
	}

	.feature {
		background: #100e0b;
		border: 1px solid rgba(236, 231, 223, 0.08);
		border-radius: 12px;
		padding: 1.5rem;
	}

	.feature h3 {
		margin: 0 0 0.6rem;
		font-size: 1rem;
		font-weight: 600;
	}

	.feature p {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.6;
		color: #a39e95;
	}

	.formats {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1rem 0 0;
		padding: 0;
	}

	.formats li {
		font-size: 0.75rem;
		color: #a39e95;
		border: 1px solid rgba(236, 231, 223, 0.12);
		border-radius: 6px;
		padding: 0.15rem 0.5rem;
	}

	@media (max-width: 760px) {
		.hero h1 {
			font-size: 2rem;
		}

		.steps,
		.features {
			grid-template-columns: 1fr;
		}
	}
</style>
